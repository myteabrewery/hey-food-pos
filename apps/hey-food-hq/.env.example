# apps/hey-food-hq/.env.local (gitignored) — copy this file to .env.local.

# Backend base URL (server-side calls only).
API_BASE_URL=http://localhost:3000

# Which business this HQ app manages. Only used at login (POST /auth/hq/login) —
# every call afterward derives businessId from the session itself, never this.
HQ_BUSINESS_ID=biz_hey_food

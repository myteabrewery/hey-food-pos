# apps/hey-food-hq/.env.local (gitignored) — copy this file to .env.local.
#
# ############################################################################
# HQ_ADMIN_KEY IS THE POWER TO CHANGE ANY PRICE FOR THE WHOLE BUSINESS.
# ############################################################################
# A TEMPORARY shared secret standing in for real HQ authentication, which does
# not exist: this app has NO LOGIN, so whoever can reach it can make it use the
# key. It is read only by this app's SERVER (never sent to a browser: no
# NEXT_PUBLIC_ prefix) and must match the backend's HQ_ADMIN_KEY. This app must
# only ever run on localhost. See the CRITICAL banner at the top of
# apps/hey-food-backend/README.md and docs/STATUS.md.
HQ_ADMIN_KEY=dev-hq-admin-key-not-a-secret

# Backend base URL (server-side calls only).
API_BASE_URL=http://localhost:3000

# Which business this HQ app manages (there is no session to derive it from).
HQ_BUSINESS_ID=biz_hey_food

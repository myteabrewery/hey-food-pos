// Prisma schema — Hey Food Backend.
// Data model per docs/hey-food-developer-spec-v1.md Section 1 / packages/shared-types.
//
// Convention: Prisma model/field names mirror shared-types' camelCase exactly
// (so a hand-written mapping layer between DB rows and API DTOs is unnecessary
// for the common case); @map()/@@map() translate those to snake_case at the
// actual Postgres column/table level. This is the same camelCase-TS /
// snake_case-DB split already used for enum string literals elsewhere in the
// codebase, just applied one layer down.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------
// Member names are kept identical to the shared-types string-literal unions
// (including underscores) so Prisma Client returns values that already match
// the api-client zod schemas with no translation step.

enum OutletStatus {
  open
  closed

  @@map("outlet_status")
}

// Which surface made a menu change. There is no "who": no authentication
// exists to attribute it to (docs/STATUS.md, audit trail).
enum MenuChangeSource {
  hq
  pos

  @@map("menu_change_source")
}

enum ConnectionStatus {
  online
  offline

  @@map("connection_status")
}

enum StaffRole {
  hq_admin
  area_manager
  outlet_staff

  @@map("staff_role")
}

enum OrderStatus {
  pending
  paid
  received
  preparing
  ready
  collected
  completed
  cancelled

  @@map("order_status")
}

enum PaymentProvider {
  billplz

  @@map("payment_provider")
}

enum PaymentStatus {
  pending
  paid
  failed

  @@map("payment_status")
}

enum NotificationChannel {
  push
  sms

  @@map("notification_channel")
}

// docs/product-customization-v1.md.
enum ModifierSelectionType {
  single
  multiple

  @@map("modifier_selection_type")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Business {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  outlets          Outlet[]
  staffUsers       StaffUser[]
  products         Product[]
  menuChangeEvents MenuChangeEvent[]

  @@map("businesses")
}

model Outlet {
  id              String       @id @default(cuid())
  businessId      String       @map("business_id")
  name            String
  address         String
  lat             Float
  lng             Float
  geofenceRadiusM Int          @map("geofence_radius_m")
  // OperatingHours (Record<day, DayHours>) has no natural relational shape —
  // stored as jsonb and typed via shared-types on the way back out.
  operatingHours  Json         @map("operating_hours")
  status          OutletStatus @default(open)
  // Short prefix for this outlet's human-facing order IDs ("PM" -> PM001,
  // PM002, ...; dev spec Section 1 / 3). Unique within a business so two
  // outlets of one business can never issue the same ID on the same day.
  displayPrefix   String       @map("display_prefix")
  createdAt       DateTime     @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  posDevices             PosDevice[]
  outletProductOverrides OutletProductOverride[]
  orders                 Order[]
  orderDailyCounters     OrderDailyCounter[]
  menuChangeEvents       MenuChangeEvent[]

  @@unique([businessId, displayPrefix])
  @@index([businessId])
  @@map("outlets")
}

// Named PosDevice (not POSDevice, unlike shared-types' interface name)
// so Prisma Client's generated accessor is the idiomatic `prisma.posDevice`
// rather than `prisma.pOSDevice` — Prisma
// lowercases only the model name's leading run of capitals, so an all-caps
// acronym like POSDevice would otherwise produce that awkward mixed-case
// accessor. The actual table name (@@map below) is unaffected either way.
model PosDevice {
  id               String           @id @default(cuid())
  outletId         String           @map("outlet_id")
  deviceName       String           @map("device_name")
  lastSeenAt       DateTime         @map("last_seen_at")
  connectionStatus ConnectionStatus @map("connection_status")

  outlet Outlet @relation(fields: [outletId], references: [id])

  @@index([outletId])
  @@map("pos_devices")
}

model StaffUser {
  id                String    @id @default(cuid())
  businessId        String    @map("business_id")
  name              String
  phone             String
  role              StaffRole
  // Plain scalar array (Postgres native text[]), matching shared-types'
  // `assignedOutletIds: string[]` verbatim rather than a join table — see
  // judgment-call notes in the summary reply for the tradeoff.
  assignedOutletIds String[]  @map("assigned_outlet_ids")
  pinHash           String    @map("pin_hash")

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@map("staff_users")
}

model Customer {
  id            String   @id @default(cuid())
  phone         String   @unique
  name          String
  createdAt     DateTime @default(now()) @map("created_at")
  loyaltyPoints Int      @default(0) @map("loyalty_points")

  orders Order[]

  @@map("customers")
}

model Product {
  id          String  @id @default(cuid())
  businessId  String  @map("business_id")
  name        String
  description String
  imageUrl    String  @map("image_url")
  category    String
  // Money stored as Decimal (numeric in Postgres), not Float, to avoid
  // floating-point rounding on currency amounts — see judgment-call notes.
  masterPrice Decimal @map("master_price") @db.Decimal(10, 2)

  business Business @relation(fields: [businessId], references: [id])

  outletProductOverrides OutletProductOverride[]
  orderItems             OrderItem[]
  modifierGroups         ProductModifierGroup[]
  menuChangeEvents       MenuChangeEvent[]

  @@index([businessId])
  @@map("products")
}

model OutletProductOverride {
  id            String   @id @default(cuid())
  outletId      String   @map("outlet_id")
  productId     String   @map("product_id")
  isAvailable   Boolean  @map("is_available")
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)

  outlet  Outlet  @relation(fields: [outletId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([outletId, productId])
  @@map("outlet_product_overrides")
}

// docs/product-customization-v2.md — supersedes v1's `required: boolean`.
// minSelections/maxSelections count DISTINCT options selected, not total
// quantity (ProductModifierOption.quantityEnabled governs that axis).
model ProductModifierGroup {
  id            String                @id @default(cuid())
  productId     String                @map("product_id")
  name          String
  selectionType ModifierSelectionType @map("selection_type")
  minSelections Int                   @map("min_selections")
  maxSelections Int?                  @map("max_selections")
  sortOrder     Int                   @map("sort_order")

  product Product                 @relation(fields: [productId], references: [id])
  options ProductModifierOption[]

  @@index([productId])
  @@map("product_modifier_groups")
}

// docs/product-customization-v2.md.
model ProductModifierOption {
  id              String  @id @default(cuid())
  groupId         String  @map("group_id")
  name            String
  priceDelta      Decimal @map("price_delta") @db.Decimal(10, 2)
  // If true, the UI offers a quantity stepper once selected (e.g. "2x
  // Fish Balls"); if false, it's a plain on/off pick.
  quantityEnabled Boolean @map("quantity_enabled")
  sortOrder       Int     @map("sort_order")
  // Nullable — real photos are added gradually per-option, not required on
  // day one.
  imageUrl        String? @map("image_url")

  group ProductModifierGroup @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@map("product_modifier_options")
}

model Order {
  id                     String      @id @default(cuid())
  outletId               String      @map("outlet_id")
  // Null for a guest (web-checkout) order — see the guest* fields below.
  customerId             String?     @map("customer_id")
  // Guest-order identity: an order is either app-based (customerId set) or
  // guest (guestPhone + guestTokenHash set), never both/neither — enforced
  // by the `orders_identity_xor` CHECK constraint, hand-written in the
  // add_guest_order_identity migration (Prisma's schema language can't
  // express CHECK constraints).
  // `guestPhone` is E.164, normalized by the (not yet built) guest endpoint.
  // `guestTokenHash` is a hash of the unguessable token returned once at
  // creation and used as the guest's proof of ownership on pay/status calls
  // — the raw token is never stored.
  guestPhone             String?     @map("guest_phone")
  guestTokenHash         String?     @map("guest_token_hash")
  // Human-facing ID ("PM001"): outlet prefix + that outlet's per-day sequence.
  // NOT globally unique — the sequence resets every business day (dev spec
  // Section 3), so uniqueness is per (outlet, business day); see
  // OrderDailyCounter and the orders_outlet_day_display_id_key index.
  displayId              String      @map("display_id")
  // The outlet-local calendar day the order was placed on (Asia/Kuala_Lumpur
  // midnight rollover), and the order's sequence number within it.
  businessDate           DateTime    @map("business_date") @db.Date
  dailySeq               Int         @map("daily_seq")
  // Client-supplied Idempotency-Key for guest order creation, so a retried
  // POST /guest/orders (lost response, double tap) returns the same order
  // instead of creating a second one. `idempotencyFingerprint` is a hash of
  // the original request body: the same key with a DIFFERENT body is a
  // client bug and is rejected rather than silently replayed.
  idempotencyKey         String?     @unique @map("idempotency_key")
  idempotencyFingerprint String?     @map("idempotency_fingerprint")
  status                 OrderStatus @default(pending)
  subtotal               Decimal     @db.Decimal(10, 2)
  serviceFee             Decimal     @map("service_fee") @db.Decimal(10, 2)
  total                  Decimal     @db.Decimal(10, 2)
  // Denormalized mirror of Payment.id once a payment succeeds; the enforced
  // FK runs the other way (Payment.orderId, unique) — see judgment-call
  // notes on the Order/Payment 1:1 shape.
  paymentId              String?     @map("payment_id")
  createdAt              DateTime    @default(now()) @map("created_at")
  paidAt                 DateTime?   @map("paid_at")
  receivedAt             DateTime?   @map("received_at")
  preparingAt            DateTime?   @map("preparing_at")
  readyAt                DateTime?   @map("ready_at")
  notifiedAt             DateTime?   @map("notified_at")
  collectedAt            DateTime?   @map("collected_at")
  completedAt            DateTime?   @map("completed_at")
  cancelledAt            DateTime?   @map("cancelled_at")
  // Always one of the clean reason values (item_unavailable | customer_no_show |
  // kitchen_error | other) — never composed text, so cancellations group
  // cleanly for reporting.
  cancelReason           String?     @map("cancel_reason")
  // Free-text explanation, populated ONLY when cancelReason is "other" —
  // enforced by the `orders_cancel_detail_only_for_other` CHECK constraint,
  // hand-written in the add_order_cancel_reason_detail migration.
  cancelReasonDetail     String?     @map("cancel_reason_detail")

  outlet   Outlet    @relation(fields: [outletId], references: [id])
  // Restrict, not Prisma's optional-relation default of SetNull: nulling
  // customerId on customer deletion would orphan the order into neither
  // "app" nor "guest" and violate orders_identity_xor. Deleting a customer
  // who has orders stays blocked, exactly as when the relation was required.
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payment  Payment?

  orderItems       OrderItem[]
  notificationLogs NotificationLog[]

  @@unique([outletId, businessDate, displayId], map: "orders_outlet_day_display_id_key")
  @@index([outletId])
  @@index([customerId])
  @@index([status])
  @@map("orders")
}

// One row per (outlet, business day): the last sequence number issued.
// Incremented with a single atomic INSERT ... ON CONFLICT DO UPDATE inside
// the order-creation transaction, so concurrent orders can never receive the
// same number, and a rolled-back order releases its number rather than
// leaving a gap.
model OrderDailyCounter {
  outletId     String   @map("outlet_id")
  businessDate DateTime @map("business_date") @db.Date
  lastSeq      Int      @map("last_seq")

  outlet Outlet @relation(fields: [outletId], references: [id])

  @@id([outletId, businessDate])
  @@map("order_daily_counters")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String  @map("order_id")
  productId     String  @map("product_id")
  nameSnapshot  String  @map("name_snapshot")
  priceSnapshot Decimal @map("price_snapshot") @db.Decimal(10, 2)
  quantity      Int
  notes         String?

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  modifiers OrderItemModifier[]

  @@index([orderId])
  @@map("order_items")
}

// Snapshot of one selected modifier option — same pattern as OrderItem's
// own nameSnapshot/priceSnapshot. docs/product-customization-v2.md.
// This modifier's contribution to the order total is
// priceDeltaSnapshot * quantity; quantity defaults to 1 for options
// where quantityEnabled was false at selection time.
model OrderItemModifier {
  id                 String  @id @default(cuid())
  orderItemId        String  @map("order_item_id")
  groupNameSnapshot  String  @map("group_name_snapshot")
  optionNameSnapshot String  @map("option_name_snapshot")
  priceDeltaSnapshot Decimal @map("price_delta_snapshot") @db.Decimal(10, 2)
  quantity           Int

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

model Payment {
  id             String          @id @default(cuid())
  orderId        String          @unique @map("order_id")
  provider       PaymentProvider
  providerRef    String          @map("provider_ref")
  status         PaymentStatus   @default(pending)
  amount         Decimal         @db.Decimal(10, 2)
  paidAt         DateTime?       @map("paid_at")
  webhookPayload Json            @map("webhook_payload")

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model NotificationLog {
  id        String              @id @default(cuid())
  orderId   String              @map("order_id")
  channel   NotificationChannel
  sentAt    DateTime            @default(now()) @map("sent_at")
  delivered Boolean             @default(false)
  payload   Json

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("notification_logs")
}

// Append-only record of menu changes: WHAT changed (a product's master field, or
// an outlet's availability / price override), from what to what, WHEN, and from
// which surface (HQ or the POS). Written in the SAME transaction as the change,
// only for changes that actually change a value. Answers "what was the price
// last month?" and "when was this item marked sold out?" — but deliberately NOT
// "who": there is no authentication yet to attribute a change to. Values are
// text ("8.50", "true"), null meaning "no value" (e.g. no price override).
// Rows are never updated or deleted by the application.
model MenuChangeEvent {
  id         String           @id @default(cuid())
  businessId String           @map("business_id")
  productId  String           @map("product_id")
  // Null for a change to the product's own master fields.
  outletId   String?          @map("outlet_id")
  // "created", "name", "description", "image_url", "category", "master_price",
  // "is_available" or "price_override".
  field      String
  oldValue   String?          @map("old_value")
  newValue   String?          @map("new_value")
  source     MenuChangeSource
  changedAt  DateTime         @default(now()) @map("changed_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  // Restrict, not Prisma's optional-relation default of SetNull: an event must
  // never lose the outlet it was about.
  outlet   Outlet?  @relation(fields: [outletId], references: [id], onDelete: Restrict)

  @@index([productId, changedAt])
  @@index([businessId, changedAt])
  @@map("menu_change_events")
}

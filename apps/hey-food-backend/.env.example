# Copy to .env and fill in for local development. Never commit .env.

DATABASE_URL="postgresql://user:password@localhost:5432/hey_food?schema=public"
PORT=3000

# Billplz (dev spec Section 8)
BILLPLZ_API_KEY=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_COLLECTION_ID=

# Push notifications (Firebase Cloud Messaging)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# SMS fallback for "ready" alert (dev spec Section 6) — Malaysia-focused aggregator
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# ---------------------------------------------------------------------------
# TEMPORARY STAND-INS — a production process REFUSES TO START if either of
# the first two is set. See "Pre-launch checklist" in README.md.
# ---------------------------------------------------------------------------
# Stub payment: POST /orders/:id/pay marks the order paid WITHOUT taking
# payment. Replaces Billplz until that integration exists.
PAYMENT_STUB_ENABLED=true
# POS_DEVICE_KEY — RETIRED. POS order endpoints now require a real staff PIN
# session (POST /auth/staff/login), not a shared secret. No env var needed.

# Guest web checkout's origin: the only origin CORS allows, and where the
# payment step redirects the browser back to.
WEB_ORIGIN=http://localhost:3002

# ---------------------------------------------------------------------------
# Notifications (dev spec Section 6) — TEMPORARY logging stubs, like the
# payment stub above: a production process REFUSES TO START with either set.
# They SEND NOTHING; they log what they would have sent and every attempt is
# recorded in notification_logs (provider "logging-stub", stub true, delivered
# false). With a flag off there is no provider and the attempt is logged as
# failed ("no provider configured").
# ---------------------------------------------------------------------------
PUSH_STUB_ENABLED=true
SMS_STUB_ENABLED=true
# DEV-ONLY fault injection for the stubs, to exercise failure paths for real:
# throw | reject | slow (3 s then accepts) | hang (never answers). Leave unset.
# PUSH_STUB_FAIL=
# SMS_STUB_FAIL=
# How long to wait on one provider before recording the attempt as failed.
# NOTIFY_PROVIDER_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# HQ ADMIN KEY — TEMPORARY, and the MOST DANGEROUS stand-in: it guards /admin/*,
# which can change ANY master price, ANY per-outlet price override and ANY
# availability for the whole business. It is NOT authentication: the HQ web app
# has no login, so whoever can use the HQ app holds this key's power. Held only in
# the HQ app's SERVER environment (apps/hey-food-hq/.env.local), never in a browser.
# Unset = /admin/* refuses everything (503). A production process REFUSES TO START
# with it set. See the CRITICAL banner at the top of README.md.
# ---------------------------------------------------------------------------
HQ_ADMIN_KEY=dev-hq-admin-key-not-a-secret

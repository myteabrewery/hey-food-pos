# Copy to .env and fill in for local development. Never commit .env.

DATABASE_URL="postgresql://user:password@localhost:5432/hey_food?schema=public"
PORT=3000

# Billplz (dev spec Section 8)
BILLPLZ_API_KEY=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_COLLECTION_ID=

# Push notifications (Firebase Cloud Messaging)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# SMS fallback for "ready" alert (dev spec Section 6) — Malaysia-focused aggregator
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# ---------------------------------------------------------------------------
# TEMPORARY STAND-INS — a production process REFUSES TO START if either of
# the first two is set. See "Pre-launch checklist" in README.md.
# ---------------------------------------------------------------------------
# Stub payment: POST /orders/:id/pay marks the order paid WITHOUT taking
# payment. Replaces Billplz until that integration exists.
PAYMENT_STUB_ENABLED=true
# Shared secret for the POS order endpoints (X-Pos-Device-Key header). Stand-in
# for real staff PIN + device-bound auth. Unset = POS endpoints answer 503.
# Dev-only placeholder value, not a secret.
POS_DEVICE_KEY=dev-pos-key-not-a-secret

# Guest web checkout's origin: the only origin CORS allows, and where the
# payment step redirects the browser back to.
WEB_ORIGIN=http://localhost:3002

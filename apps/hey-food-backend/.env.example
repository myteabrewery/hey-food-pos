# Copy to .env and fill in for local development. Never commit .env.

DATABASE_URL="postgresql://user:password@localhost:5432/hey_food?schema=public"
PORT=3000

# Billplz (dev spec Section 8)
BILLPLZ_API_KEY=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_COLLECTION_ID=

# Push notifications (Firebase Cloud Messaging)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# SMS fallback for "ready" alert (dev spec Section 6) — Malaysia-focused aggregator
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# Copy to .env (read by Expo at Metro start; restart Metro with --clear after changing).

# Backend base URL. On a USB phone, `adb reverse tcp:3000 tcp:3000` makes localhost work.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# TEMPORARY — MUST BE REPLACED BEFORE PRODUCTION. Shared secret matching the
# backend's POS_DEVICE_KEY. EXPO_PUBLIC_* values are compiled into the app
# bundle, so this is NOT secret; it stands in for real staff-PIN/device auth.
EXPO_PUBLIC_POS_DEVICE_KEY=dev-pos-key-not-a-secret

# Set to 1 to run the queue on built-in mock orders with no backend (demos).
# EXPO_PUBLIC_POS_USE_MOCK_ORDERS=1

# Copy to .env (read by Expo at Metro start; restart Metro with --clear after changing).

# Backend base URL. On a USB phone, `adb reverse tcp:3000 tcp:3000` makes localhost work.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Which business this POS app belongs to — sent as `businessId` on every
# staff login (a PIN is only unique within a business). Mirrors the HQ app's
# own HQ_BUSINESS_ID; a real deployment's tablets would ship with the real
# business's id baked in, not this dev default.
EXPO_PUBLIC_POS_BUSINESS_ID=biz_hey_food

# POS_DEVICE_KEY — RETIRED. Real staff PIN login (POST /auth/staff/login)
# replaced it; no shared secret or env var is needed on the POS side either.

# Set to 1 to run the queue on built-in mock orders with no backend (demos).
# EXPO_PUBLIC_POS_USE_MOCK_ORDERS=1
